#!/usr/bin/env python3
"""routing-setup [--check]

Turns on Claude Code's built-in plan -> execute split in your user settings:
  "model": "opusplan"                    Opus while planning, Sonnet while executing
  "showClearContextOnPlanAccept": true   plan approval offers "Yes, clear context",
                                         which runs the plan in a fresh session

Backs up settings.json first. --check only reports what would change.
"""
import json
import os
import shutil
import sys
import time
from pathlib import Path

WANT = {"model": "opusplan", "showClearContextOnPlanAccept": True}


def main(argv):
    check = "--check" in argv
    config_dir = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
    path = config_dir / "settings.json"
    try:
        settings = json.loads(path.read_text()) if path.exists() else {}
    except ValueError as exc:
        print(f"{path} isn't valid JSON ({exc}). Fix it first; nothing changed.", file=sys.stderr)
        return 1
    if not isinstance(settings, dict):
        print(f"{path} doesn't contain a JSON object; nothing changed.", file=sys.stderr)
        return 1

    changes = [(k, settings.get(k), v) for k, v in WANT.items() if settings.get(k) != v]
    if not changes:
        print(f"Already set in {path}. Nothing to change.")
        return 0
    for key, old, new in changes:
        print(f"{key}: {json.dumps(old)} -> {json.dumps(new)}")
    if check:
        print("(--check: nothing written)")
        return 0

    if path.exists():
        backup = path.with_name(f"settings.json.bak-{time.strftime('%Y%m%d-%H%M%S')}")
        shutil.copy2(path, backup)
        print(f"Backup: {backup}")
    settings.update(WANT)
    config_dir.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(settings, indent=2) + "\n")
    print(f"Updated {path}. Takes effect in new sessions; in this one, run /model opusplan.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
