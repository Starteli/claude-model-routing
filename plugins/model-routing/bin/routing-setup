#!/usr/bin/env python3
"""routing-setup [--check | --apply] [--executor sonnet|same]

Turns on Claude Code's built-in "run the approved plan in a fresh session":
  "showClearContextOnPlanAccept": true   plan approval offers "Yes, clear context"

--executor same (default) leaves your model alone, so plans run on whatever
  model you're using, and removes "opusplan" if an earlier run set it.
--executor sonnet also sets
  "model": "opusplan"                    Opus while planning, Sonnet while executing
  Warning: a pinned opusplan stops Claude Code's server-provided model mix
  (a lead model with cheaper worker subagents, shown as its own row in /model),
  because the mix only applies while the session model is its lead model.

Backs up settings.json before writing. --check only reports what would change.
"""
import argparse
import json
import os
import shutil
import sys
import time
from pathlib import Path


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--apply", action="store_true")
    ap.add_argument("--executor", choices=["sonnet", "same"], default="same")
    args = ap.parse_args()

    config_dir = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
    path = config_dir / "settings.json"
    try:
        settings = json.loads(path.read_text()) if path.exists() else {}
    except ValueError as exc:
        print(f"{path} isn't valid JSON ({exc}). Fix it first; nothing changed.", file=sys.stderr)
        return 1
    if not isinstance(settings, dict):
        print(f"{path} doesn't contain a JSON object; nothing changed.", file=sys.stderr)
        return 1

    new = dict(settings)
    new["showClearContextOnPlanAccept"] = True
    if args.executor == "sonnet":
        new["model"] = "opusplan"
    elif new.get("model") == "opusplan":
        del new["model"]

    changes = [(k, settings.get(k), new.get(k))
               for k in ("model", "showClearContextOnPlanAccept")
               if settings.get(k) != new.get(k)]
    if not changes:
        print(f"Already set in {path}. Nothing to change.")
        return 0
    for key, old, val in changes:
        shown = "(removed, back to Claude Code's default)" if val is None else json.dumps(val)
        print(f"{key}: {json.dumps(old)} -> {shown}")
    if not args.apply:
        print("(check only: nothing written)")
        return 0

    if path.exists():
        backup = path.with_name(f"settings.json.bak-{time.strftime('%Y%m%d-%H%M%S')}")
        shutil.copy2(path, backup)
        print(f"Backup: {backup}")
    config_dir.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(new, indent=2) + "\n")
    print(f"Updated {path}. Takes effect in new sessions.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
