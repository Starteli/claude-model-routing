{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|resume|compact|fork",
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" session_start || true", "timeout": 10}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" prompt_hook || true", "timeout": 5}
        ]
      }
    ],
    "PreModelSwitch": [
      {
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" switch_guard || true", "timeout": 10}
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" after_switch || true", "timeout": 10}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Skill",
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" track_agent || true", "timeout": 5}
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" plan_approved || true", "timeout": 5}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" receipt || true", "timeout": 5}
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" pre_compact || true", "timeout": 10}
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" post_compact || true", "timeout": 30}
        ]
      }
    ]
  }
}
