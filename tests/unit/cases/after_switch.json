[
 {
  "name": "as-1 records the switch",
  "script": "after_switch",
  "stdin": {
   "session_id": "s1",
   "hook_event_name": "PostModelSwitch",
   "from_model": "claude-opus-5-5",
   "to_model": "claude-sonnet-5",
   "source": "picker"
  },
  "expect": {
   "stdout_empty": true,
   "record": {
    "main_model": "claude-sonnet-5",
    "last_switch": {
     "source": "picker",
     "from": "claude-opus-5-5",
     "to": "claude-sonnet-5",
     "ts": "$RECENT"
    }
   }
  }
 },
