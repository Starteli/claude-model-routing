[
 {
  "name": "ss-1 OPEN startup",
  "script": "session_start",
  "stdin": {
   "session_id": "s1",
   "hook_event_name": "SessionStart",
   "cwd": "$T/project",
   "source": "startup",
   "model": "claude-opus-5-5"
  },
  "expect": {
   "json_startswith": {
    "hookSpecificOutput.additionalContext": "Current routing (replaces earlier routing notes): subagent models are selectable"
   },
   "json_equals": {
    "systemMessage": "Routing on \u00b7 recall Haiku \u00b7 build Sonnet \u00b7 hard Opus"
   },
   "record": {
    "state": {
     "mode": "OPEN"
    },
    "main_model": "claude-opus-5-5",
    "lead": null,
    "session_id": "s1"
   }
  }
 },
